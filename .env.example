# ============================================
# PBN Backend - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# SERVER CONFIG
# ============================================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ============================================
# DATABASE - MongoDB
# ============================================
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/pbn

# OR MongoDB Atlas (Cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pbn

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=7d

# ============================================
# ANTHROPIC CLAUDE API
# ============================================
# Get API key from: https://console.anthropic.com/account/keys
CLAUDE_API_KEY=sk-ant-your-key-here

# ============================================
# EMAIL SERVICE - Gmail SMTP
# ============================================
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM=noreply@pbn-platform.com

# ============================================
# ADMIN CREDENTIALS
# ============================================
ADMIN_EMAIL=admin@pbn-platform.com
ADMIN_DEFAULT_PASSWORD=Change@123

# ============================================
# CORS & SECURITY
# ============================================
CORS_ORIGIN=http://localhost:3000

# ============================================
# OPTIONAL: External Services
# ============================================
# Error Tracking (Sentry)
# SENTRY_DSN=

# File Storage (AWS S3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=pbn-uploads
